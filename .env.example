# Frontend config for local development. Copy to .env.local.
# NEVER commit .env.local or any file containing real secrets.
# Server secrets live only in selfhost/.env on ajmsd (see selfhost/.env.example).

# API base URL (self-hosted gateway)
VITE_API_URL=https://wurmple-api.ajmsd.space

# Public anon key (safe to expose; it's in the built frontend).
# On ajmsd: grep ^ANON_KEY= ~/Code/Pokemon-Wordle/selfhost/.env
VITE_API_ANON_KEY=your-anon-key-here
