# Copy to selfhost/.env (chmod 600). Never commit the real file.
# Generate POSTGRES_PASSWORD / JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY with
#   node selfhost/scripts/gen-keys.mjs

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY=3600
# GoTrue password minimum is fixed at 8 in docker-compose.yml.
# Optional: salt for per-user daily targets. Unset = derived from JWT_SECRET
# (rotating JWT_SECRET then reshuffles every user's target; set this to pin it).
TARGET_SALT=

API_EXTERNAL_URL=https://wurmple-api.ajmsd.space
SITE_URL=https://wurmple.ajmsd.space
ADDITIONAL_REDIRECT_URLS=https://wurmple.ajmsd.space/**

# Brevo SMTP (Transactional > SMTP & API > SMTP tab)
SMTP_ADMIN_EMAIL=no-reply@ajmsd.space
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Wurmple

# Google OAuth client (redirect URI: https://wurmple-api.ajmsd.space/auth/v1/callback)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
