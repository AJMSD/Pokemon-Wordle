# Copy to selfhost/.env (chmod 600). Never commit the real file.
# Generate POSTGRES_PASSWORD / TARGET_SALT with
#   node selfhost/scripts/gen-keys.mjs

POSTGRES_PASSWORD=
# Salt for per-user daily targets. Set once, never change: changing it changes
# every player's daily Pokémon.
TARGET_SALT=

API_URL=https://wurmple-api.ajmsd.space
SITE_URL=https://wurmple.ajmsd.space

# Brevo SMTP (Transactional > SMTP & API > SMTP tab)
SMTP_ADMIN_EMAIL=no-reply@ajmsd.space
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Wurmple
# smtp (default) or log (print emails to the api container's log instead)
MAIL_MODE=smtp

# Google OAuth client (authorized redirect URI:
#   https://wurmple-api.ajmsd.space/v1/auth/google/callback)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
